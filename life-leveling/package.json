{
  "name": "life-leveling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "android:sync": "npm run build && npx cap sync android",
